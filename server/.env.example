# Puerto del servidor
PORT=3001

# Cadena de conexión a PostgreSQL
# En Render: copia la Internal Database URL de tu base de datos
DATABASE_URL=postgresql://user:password@host:5432/ecovida

# SSL de PostgreSQL: "true" en Render, vacío o "false" para Postgres local sin SSL
DB_SSL=true

# Secreto para firmar JWT (genera uno largo y aleatorio; NUNCA lo subas a git)
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio

# Origen permitido por CORS (separados por coma si hay varios)
CORS_ORIGIN=https://ecovida-frontend.onrender.com

# STAGING: activa el endpoint temporal POST /api/_debug/reset-seed.
# NUNCA activar en producción (ver README y PENTESTING-EJECUCION.md).
# STAGING_MODE=true
